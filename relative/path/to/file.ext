```python
# Add dry-run option to deploy command in main.py

class DeployCommand:
    def __init__(self, manifest):
        self.manifest = manifest

    def run(self, dry_run=False):
        if dry_run:
            print("Dry-run mode enabled. No backend mutation will occur.")
            return True  # Return True to indicate dry-run was successful
        else:
            # Existing deploy logic here
            pass
```

